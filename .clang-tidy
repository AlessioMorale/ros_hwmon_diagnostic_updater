---
Checks: '-*,clang-analyzer-*,bugprone-*,performance-*,readability-*,modernize-*,hicpp-*,cppcoreguidelines-*'
WarningsAsErrors: ''
HeaderFilterRegex: '.*'
AnalyzeTemporaryDtors: false
FormatStyle: none
User: ''

CheckOptions:
  - key:             modernize-use-nullptr.NullMacros
    value:           'NULL'
  - key:             readability-identifier-naming.VariableCase
    value:           lower_case
  - key:             readability-identifier-naming.FunctionCase
    value:           CamelCase
  - key:             cppcoreguidelines-pro-type-vararg.InitializerList
    value:           'true'
